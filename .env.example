APP_NAME=GenAI Customer Support Bot
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

API_PREFIX=/api/v1

SQLITE_DATABASE_URL=sqlite:///./data/sqlite/app_support.db
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=

CHROMA_COLLECTION_NAME=app_knowledge_base
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.30

LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name
LLM_BASE_URL=

CHAT_RATE_LIMIT=10/minute
MAX_CHAT_HISTORY=10